#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -e

BUILD_DIR=$1

BIN_DIR=$(
  cd "$(dirname "$0")"
  pwd
)
ROOT_DIR=$(dirname "$BIN_DIR")

BUILD_VENDOR="$BUILD_DIR/vendor/imagemagick"
RUNTIME_VENDOR="/app/vendor/imagemagick"

echo "-----> Vendoring ImageMagick into vendor/imagemagick"

mkdir -p "$BUILD_VENDOR"
tar -xj -f "$ROOT_DIR/build/imagemagick.tar.bz2" -C "$BUILD_VENDOR"

# The binary was built with a --prefix that only existed in the build container
# and is linked against the libraries shipped next to it, so every consumer has
# to be told where the tree actually lives. Buildpacks that run after this one
# read $ROOT_DIR/export, where the tree is still under the build directory; the
# dynos read .profile.d, where it has become /app.
write_env() {
  local vendor="$1"

  cat <<EOF
export PATH="$vendor/bin:\$PATH"
export LD_LIBRARY_PATH="$vendor/lib:\$LD_LIBRARY_PATH"
export LIBRARY_PATH="$vendor/lib:\$LIBRARY_PATH"
export PKG_CONFIG_PATH="$vendor/lib/pkgconfig:\$PKG_CONFIG_PATH"
export CPATH="$vendor/include:\$CPATH"
EOF
}

write_env "$BUILD_VENDOR" >"$ROOT_DIR/export"

mkdir -p "$BUILD_DIR/.profile.d"
write_env "$RUNTIME_VENDOR" >"$BUILD_DIR/.profile.d/imagemagick.sh"

LD_LIBRARY_PATH="$BUILD_VENDOR/lib:$LD_LIBRARY_PATH" \
  "$BUILD_VENDOR/bin/magick" -version | head -1 | sed "s/^/-----> /"
